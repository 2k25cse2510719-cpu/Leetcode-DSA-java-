import java.util.Stack;
class Solution {
    public boolean backspaceCompare(String s, String t) {
      Stack<Character>stack1=new Stack<>();
      int k=0;
      int n=s.length();
      while(k<n){
        if(s.charAt(k)=='#'&& !stack1.isEmpty()){
            stack1.pop();
        }
        else if(s.charAt(k)!='#'){
            char ch=s.charAt(k);
            stack1.push(ch);
        }
        k++;
      }
       Stack<Character>stack2=new Stack<>();
      int k1=0;
      int n1=t.length();
      while(k1<n1){
        if(t.charAt(k1)=='#'&& !stack2.isEmpty()){
            stack2.pop();
        }
        else if(t.charAt(k1)!='#'){
            char ch=t.charAt(k1);
            stack2.push(ch);
        }
        k1++;
      }
      if(stack1.equals(stack2)){
        return true;
      }
      else{
        return false;
      }
    }
}
