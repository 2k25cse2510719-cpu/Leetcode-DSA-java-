import java.util.Stack;
class Solution {
    public void rotate(int[] nums, int k) {
        int n = nums.length;
        k = k % n;
        Stack<Integer> stack = new Stack<>();
        for (int i = n - k - 1; i >= 0; i--) {
            stack.push(nums[i]);
        }
        for (int i = n - 1; i >= n - k; i--) {
            stack.push(nums[i]);
        }
        for (int i = 0; i < n; i++) {
            nums[i] = stack.pop();
        }
    }
}
