class Solution {
    public List<Integer> findDuplicates(int[] nums) {
       HashMap<Integer,Integer>map=new HashMap<>();
       Arrays.sort(nums);
       List<Integer>list=new ArrayList<>();
       for(int i=0;i<nums.length;i++){
        int x=nums[i];
        if(map.containsKey(x)){
            list.add(x);
        }
        else{
            map.put(x,map.getOrDefault(x,0)+1);
        }
       } 
       return list;
    }
} 
