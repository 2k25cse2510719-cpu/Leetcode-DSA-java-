class Solution {
    public ListNode middleNode(ListNode head) {
        ListNode temp = head;
        int count = 0;

        while (temp != null) {
            count++;
            temp = temp.next;
        }

        int mid = count / 2;

        while (mid > 0) {
            head = head.next;
            mid--;
        }

        return head;
    }
}
