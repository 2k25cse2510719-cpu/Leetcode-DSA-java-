class Solution {
    public int subarraysDivByK(int[] nums, int k) {
        int count = 0;
        int prefixSum = 0;

        HashMap<Integer, Integer> map = new HashMap<>();
        map.put(0, 1);

        for (int i = 0; i < nums.length; i++) {
            prefixSum += nums[i];

            int mod = prefixSum % k;

            if (mod < 0) {
                mod += k;
            }

            count += map.getOrDefault(mod, 0);

            map.put(mod, map.getOrDefault(mod, 0) + 1);
        }

        return count;
    }
}
