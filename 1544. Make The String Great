import java.util.Stack;
class Solution {
    public String makeGood(String s) {
          String x;
        Stack<Character>stack=new Stack<>();
        StringBuilder sb= new StringBuilder();
        for(int i =0 ;i<s.length();i++){
            char current=s.charAt(i);
            if (!stack.isEmpty() &&
    (stack.peek() == current + 32 ||
     stack.peek() == current - 32)){
                stack.pop();
            }
            else{
                stack.push(current);
            }
        }
       for(char c:stack){
sb.append(c);
       }
              return sb.toString();
        }
    }
