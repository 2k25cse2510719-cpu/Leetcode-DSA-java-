class Solution {
    public int missingMultiple(int[] nums, int k) {
        HashSet<Integer>set=new HashSet<>();
        for(int num:nums){
            set.add(num);
        }
        for(int i =0;i<nums.length+1;i++){
            int multi=k*(1+i);
            if(!set.contains(multi)){
                return multi;
            }
        }
        return -1;
    }
}
