class Solution {
    public int compress(char[] chars) {
        int n=chars.length;
        int read=0;
        int write=0;
        while(read<n){
            char current=chars[read];
            int count=0;
            while(read<n&&chars[read]==current){
                read++;
                count++;
            }
            chars[write++]=current;
           if(count>1){
           for(char ch: String.valueOf(count).toCharArray())
           chars[write++]=ch;
           }
        }
        return write;
    }
}
